{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "aucklandsbestpunters",
  "main": "src/worker.js",
  "compatibility_date": "2025-09-01",

  // The site lives in /public and is served by the Worker.
  // Unmatched paths (like /api/state) fall through to src/worker.js.
  "assets": {
    "directory": "./public",
    "binding": "ASSETS"
  },

  "observability": { "enabled": true },

  // The shared ledger. Every member's browser pushes here, the Worker merges
  // by bet id with the newest edit winning, so nobody clobbers anybody.
  // Optional lock: Worker → Settings → Variables and Secrets → add a secret
  // named CLUB_CODE. The site then asks each device for it once.
  "kv_namespaces": [
    { "binding": "LEDGER", "id": "d5f5e35daa5a487d9eced911fd503f77" }
  ]
}
